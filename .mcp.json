{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "@21st-dev/magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${MAGIC_API_KEY}"
      }
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${TWENTY_FIRST_API_KEY}"
      }
    },
    "vapi-mcp": {
      "type": "http",
      "url": "https://mcp.vapi.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${VAPI_TOKEN}"
      }
    }
  }
}
