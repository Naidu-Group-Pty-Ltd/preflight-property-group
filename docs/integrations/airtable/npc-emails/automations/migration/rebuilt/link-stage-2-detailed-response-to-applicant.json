{
 "baseId": "appFNPL7iYiuQyHAO",
 "name": "Link Stage 2 detailed response to applicant",
 "description": "Turns the Application ID carried on a BRQ Detailed Response into a real link to the Aurixa Waitlist applicant. This is what makes Stage 1 aware that the applicant progressed: once the link exists, Stage 2 Reached flips to 1 on the waitlist record and Send Stage 2 Invite reads HOLD, so the scheduled Stage 1 reminder skips them. Fires when a response has an Application ID but no Applicant link, which covers both new submissions and records back-filled later. Matching is on Application ID Key (upper-cased and trimmed), so a reference typed by hand \u2014 the fallback path when the emailed link has expired \u2014 still resolves. When nothing matches, the response is left alone and Applicant Link Status reads \"Unlinked - no matching applicant\".",
 "trigger": {
  "type": "recordMatchesConditions",
