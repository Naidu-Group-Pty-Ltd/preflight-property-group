  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "src/pages/solicitor/**/*.ts",
    "src/pages/solicitor/**/*.tsx",
    "src/components/solicitor-portal/**/*.ts",
